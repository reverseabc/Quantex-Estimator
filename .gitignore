# Dependencies
node_modules/

# Build output
dist/

# Logs
logs/
*.log
npm-debug.log*

# Test coverage
coverage/
*.lcov

# Tool caches
.eslintcache
.cache/

# Cloudflare Wrangler local state
.wrangler/

# Environment variables and secrets: never commit
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Database exports and backups (e.g. `wrangler d1 export`): keep outside the repo.
# Only the schema and versioned migrations are committed.
*.sql
!schema.sql
!migrations/*.sql

# Legacy local data files
data/users.json
data/db.json

# Admin seed output (contains a password hash)
seed-admin.sql

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
